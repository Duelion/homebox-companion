{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold warning --diagnostic-sources js,svelte && tsc --noEmit --project tsconfig.browser.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --threshold warning --diagnostic-sources js,svelte",
		"lint": "eslint src tests *.config.js *.config.ts eslint --max-warnings 0 && npm run lint:css",
		"lint:css": "node eslint/check-css-tokens.js",
		"lint:fix": "eslint src tests *.config.js *.config.ts eslint --fix --max-warnings 0 && npm run lint:css",
		"format": "prettier --write src tests eslint *.config.js *.config.ts *.json .prettierrc",
		"format:check": "prettier --check src tests eslint *.config.js *.config.ts *.json .prettierrc",
		"test:unit": "node --test tests/unit/*.test.js",
		"test:browser": "npm run build && npm run test:browser:run",
		"test:browser:run": "playwright test",
		"verify": "npm run check && npm run lint && npm run format:check && npm run test:unit"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^26.6.1",
		"eslint": "^10.9.1",
		"eslint-plugin-svelte": "^3.23.0",
		"eslint-plugin-tailwindcss": "4.4.0",
		"globals": "^17.11.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "0.7.4",
		"rollup-plugin-visualizer": "^7.0.1",
		"svelte": "^5.53.2",
		"svelte-check": "^4.4.3",
		"svelte-eslint-parser": "^1.8.1",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.2",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@lucide/svelte": "^1.0.1",
		"heic2any": "^0.0.4",
		"idb": "^8.0.3",
		"qr-scanner": "^1.4.2",
		"rehype-external-links": "^3.0.0",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5"
	},
	"overrides": {
		"cookie": "^0.7.0",
		"brace-expansion": "^5.0.12",
		"devalue": "^5.9.4"
	}
}
