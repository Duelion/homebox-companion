{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold warning --diagnostic-sources js,svelte && tsc --noEmit --project tsconfig.browser.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --threshold warning --diagnostic-sources js,svelte",
		"lint": "eslint src tests playwright.config.ts eslint.config.js --max-warnings 0",
		"lint:fix": "eslint src tests playwright.config.ts eslint.config.js --fix --max-warnings 0",
		"format": "prettier --write src tests playwright.config.ts package.json tsconfig.browser.json",
		"format:check": "prettier --check src tests playwright.config.ts package.json tsconfig.browser.json",
		"test:browser": "npm run build && npm run test:browser:run",
		"test:browser:run": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "^26.6.1",
		"eslint": "^10.9.1",
		"eslint-plugin-svelte": "^3.23.0",
		"eslint-plugin-tailwindcss": "4.4.0",
		"globals": "^17.11.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "0.7.4",
		"rollup-plugin-visualizer": "^7.0.1",
		"svelte": "^5.53.2",
		"svelte-check": "^4.4.3",
		"svelte-eslint-parser": "^1.8.1",
		"tailwindcss": "4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@lucide/svelte": "^1.0.1",
		"heic2any": "^0.0.4",
		"idb": "^8.0.3",
		"qr-scanner": "^1.4.2",
		"rehype-external-links": "^3.0.0",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5"
	},
	"overrides": {
		"@typescript-eslint/eslint-plugin": {
			"ignore": "7.0.8"
		},
		"cookie": "^0.7.0",
		"baseline-browser-mapping": "2.11.16",
		"brace-expansion": "5.0.12",
		"browserslist": "4.28.8",
		"devalue": "5.9.4",
		"nanoid": "3.3.18",
		"caniuse-lite": "1.0.30001809",
		"@emnapi/core": "1.11.3",
		"@emnapi/runtime": "1.11.3",
		"electron-to-chromium": "1.5.411",
		"enhanced-resolve": "5.24.5",
		"node-releases": "2.0.53",
		"picomatch": "4.0.5",
		"update-browserslist-db": "1.3.1"
	}
}
