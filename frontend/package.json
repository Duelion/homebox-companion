{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --threshold warning --diagnostic-sources js,svelte",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch --threshold warning --diagnostic-sources js,svelte",
		"lint": "eslint src",
		"lint:fix": "eslint src --fix",
		"format": "prettier --write src",
		"format:check": "prettier --check src",
		"test:browser": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/node": "^25.3.0",
		"autoprefixer": "^10.4.24",
		"eslint": "^10.0.1",
		"eslint-plugin-svelte": "^3.15.0",
		"eslint-plugin-tailwindcss": "^3.18.2",
		"globals": "^17.3.0",
		"postcss": "8.5.26",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.0",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"rollup-plugin-visualizer": "^7.0.1",
		"svelte": "^5.53.2",
		"svelte-check": "^4.4.3",
		"svelte-eslint-parser": "^1.4.1",
		"tailwindcss": "^3.4.18",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.59.2",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"heic2any": "^0.0.4",
		"idb": "^8.0.3",
		"lucide-svelte": "^0.575.0",
		"qr-scanner": "^1.4.2",
		"rehype-external-links": "^3.0.0",
		"rehype-sanitize": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5"
	},
	"overrides": {
		"cookie": "^0.7.0",
		"baseline-browser-mapping": "2.11.16",
		"brace-expansion": "5.0.9",
		"browserslist": "4.28.8",
		"devalue": "5.9.1",
		"nanoid": "3.3.18",
		"caniuse-lite": "1.0.30001809",
		"@emnapi/core": "1.11.3",
		"@emnapi/runtime": "1.11.3",
		"electron-to-chromium": "1.5.411",
		"node-releases": "2.0.53",
		"picomatch": "4.0.5",
		"update-browserslist-db": "1.3.1"
	}
}
