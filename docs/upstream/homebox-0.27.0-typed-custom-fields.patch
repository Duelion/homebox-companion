@@ -0,0 +1,30 @@
+import { describe, expect, it } from "vitest";
+import { fieldDisplayText } from "./field-display";
+
+describe("fieldDisplayText", () => {
+  it.each([
+    [{ type: "number", numberValue: 0 }, "0"],
+    [{ type: "number", numberValue: 42 }, "42"],
+    [{ type: "boolean", booleanValue: false }, "Non"],
+    [{ type: "boolean", booleanValue: true }, "Oui"],
+    [{ type: "text", textValue: "木材 & optics" }, "木材 & optics"],
+    [{ type: "text", textValue: "[Link](https://example.com)" }, "[Link](https://example.com)"],
+    [{ type: "text", textValue: "" }, ""],
+    [{ type: "text", textValue: null }, ""],
+    [{ type: "number", numberValue: null }, ""],
+    [{ type: "boolean", booleanValue: null }, ""],
+    [{ type: "boolean" }, ""],
+  ])("formats %j as %j", (field, expected) => {
+    expect(fieldDisplayText(field, "Oui", "Non")).toBe(expected);
+  });
+
+  it("does not mutate stored typed values", () => {
+    const field = Object.freeze({
+      type: "number",
+      numberValue: 0,
+      textValue: "inactive",
+    });
+    expect(fieldDisplayText(field, "Yes", "No")).toBe("0");
+    expect(field.textValue).toBe("inactive");
+  });
+});
diff --git a/frontend/lib/field-display.ts b/frontend/lib/field-display.ts
