--- /dev/null
+++ b/frontend/lib/field-display.ts
@@ -0,0 +1,19 @@
+import type { EntityFieldData } from "./api/types/data-contracts";
+
+type DisplayField = Pick<EntityFieldData, "type"> & {
+  textValue?: string | null;
+  numberValue?: number | null;
+  booleanValue?: boolean | null;
+};
+
+/** Format only the field's active value, preserving zero and false. */
+export function fieldDisplayText(field: DisplayField, yes: string, no: string): string {
+  switch (field.type) {
+    case "number":
+      return field.numberValue == null ? "" : String(field.numberValue);
+    case "boolean":
+      return field.booleanValue == null ? "" : field.booleanValue ? yes : no;
+    default:
+      return field.textValue ?? "";
+  }
+}
